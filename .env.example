# Copy this file to .env in this same folder (the repo root) and fill in
# your own values. backend/agent.py walks up from backend/ looking for a
# .env file, so a .env placed here is picked up automatically.

# Required: your Portkey API key (used to reach the chat model).
PORTKEY_API_KEY=

# Optional: override the Portkey-side model alias (defaults to gpt-6-luna).
MODEL_NAME=gpt-6-luna

# Optional: override the Portkey gateway URL (defaults to the public one below).
PORTKEY_BASE_URL=https://api.portkey.ai/v1
